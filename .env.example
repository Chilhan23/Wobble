# App
APP_NAME=wobble
APP_ENV=development
APP_PORT=8080
BASE_URL=http://localhost:8080

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=wobble_db
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wobble_db?sslmode=disable

# Auth & Security (buat dengan: openssl rand -hex 32)
TOKEN_SECRET=
TOKEN_TTL_HOURS=24
FILE_SIGNING_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# AI (Privasi data pasien: kosongkan AI_API_KEY untuk nonaktifkan AI, atau gunakan on-premise AI_ENDPOINT seperti Ollama / vLLM)
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=
AI_HISTORY_LIMIT=

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_IMAGE_MB=5
MAX_UPLOAD_VIDEO_MB=15